{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "TodoWrite",
        "hooks": [
          {
            "type": "command",
            "command": "ctxloom tasks capture --stdin"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "ctxloom tasks stamp-plan"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ctxloom session bind"
          },
          {
            "type": "command",
            "command": "ctxloom hook inject-context --project '/home/babbitt/workspace/angzarr/core/main' --part 1 --of 8 86d418f13dffbd1c",
            "timeout": 60
          },
          {
